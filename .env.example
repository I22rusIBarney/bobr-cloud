# --- Telegram ---
BOT_TOKEN=123456:ABC...
# Telegram ID админов через запятую (узнать: @userinfobot)
ADMIN_IDS=111111111
SUPPORT_USERNAME=astravps_support

# --- Публичный HTTPS-адрес сервиса (нужен для Mini App и вебхука ЮKassa) ---
PUBLIC_URL=https://bot.example.com
# Случайная строка: часть пути вебхука ЮKassa
WEBHOOK_SECRET=change-me-long-random

# --- Astra VPS (реселлерский API) ---
ASTRA_API_KEY=rsl_...
ASTRA_BASE_URL=https://astravps.co/api/reseller/v1

# --- ЮKassa ---
# Ключи ЮKassa и «Мой налог» вводятся в админке бота. Эти поля — необязательный запасной вариант.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Чеки самозанятого (Мой налог). Пусто = чеки выключены ---
NALOG_INN=
NALOG_PASSWORD=

# --- Прочее ---
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
WEB_HOST=0.0.0.0
WEB_PORT=8080
